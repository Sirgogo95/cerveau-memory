DJANGO_ENV = dev
SECRET_KEY = CHANGE_ME
REDIS_URL = 

# Postgres with pgvector: `docker compose up -d` (docker-compose.yml) matches these values
DATABASE_URL__DEV = postgres://cerveau:cerveau@localhost:5432/cerveau
DATABASE_URL__EVAL = postgres://cerveau:cerveau@localhost:5432/cerveau_eval

# Cerveau engine: a profile name from configs/models/ (without .toml), the engine
# config file, and the Ollama server.
CERVEAU_CHAT_MODEL = gemma4-e4b
# Profile for background work (consolidation); defaults to the chat model.
# Defaults to the chat profile's "-background" variant when it exists (same model,
# lower temperature), else the chat profile.
# CERVEAU_BACKGROUND_MODEL = gemma4-e4b-background
# Reranker: a cross-encoder that re-reads recall's shortlist against the message.
# Needs PyTorch: pip install -r requirements-optional.txt
# Off when empty. Measured on LoCoMo: more evidence recalled, same answers, about
# 5.6 s more per reply on the CPU (docs/GUIDE.md 4.8). Downloads about 2 GB once.
# CERVEAU_RERANKER = BAAI/bge-reranker-v2-m3
# CERVEAU_RERANKER_DEVICE = cpu
CERVEAU_ENGINE_CONFIG = configs/default.toml
OLLAMA_BASE_URL = http://127.0.0.1:11434
# Embedding profile, a file in configs/embeddings/ (bge-m3 runs on Ollama; all-MiniLM-L6-v2 runs
# on the CPU and needs requirements-optional.txt). Changing it means
# re-embedding: python manage.py embed_memory
CERVEAU_EMBEDDING_MODEL = bge-m3
# Load the embedding and chat models when the server starts instead of on the first
# message (true/false).
CERVEAU_WARM_START = true
# Shared files: where they're stored (outside the repository) and the size limit.
# CERVEAU_ATTACHMENTS_DIR = C:/Users/you/cerveau-data/attachments
# CERVEAU_MAX_ATTACHMENT_MB = 25

# OIDC client settings

# dev
OIDC_PROVIDER_ID_DEV =
OIDC_NAME_DEV =
OIDC_CLIENT_ID_DEV = 
OIDC_CLIENT_SECRET_DEV = 
OIDC_SERVER_URL_DEV = http://localhost:8000/.well-known/openid-configuration

# prod
OIDC_PROVIDER_ID_PROD =
OIDC_NAME_PROD =
OIDC_CLIENT_ID_PROD =
OIDC_CLIENT_SECRET_PROD =
OIDC_SERVER_URL_PROD =

# Google auth (additional login; combinable with Microsoft, not with OIDC)

# dev
GOOGLE_CLIENT_ID_DEV =
GOOGLE_CLIENT_SECRET_DEV =

# prod
GOOGLE_CLIENT_ID_PROD =
GOOGLE_CLIENT_SECRET_PROD =

# Microsoft Entra ID auth (additional login; combinable with Google, not with OIDC)
# TENANT: a tenant GUID (one organization), "organizations", "consumers" or "common".
# Redirect URI to register in Azure: <origin>/accounts/microsoft/login/callback/

# dev
MICROSOFT_CLIENT_ID_DEV =
MICROSOFT_CLIENT_SECRET_DEV =
MICROSOFT_TENANT_DEV = organizations

# prod
MICROSOFT_CLIENT_ID_PROD =
MICROSOFT_CLIENT_SECRET_PROD =
MICROSOFT_TENANT_PROD = organizations

# Annotations channel (dev only, research preview). Push sent annotations into a live
# Claude Code session. Leave URL blank to disable; when set, the secret and the URL
# port must match the ones the channel server (run at user scope, not vendored
# here) was started with.
ANNOTATIONS_CHANNEL_URL =
ANNOTATIONS_CHANNEL_SECRET = change-me-annotations
